---
import type { CollectionEntry } from 'astro:content';
import ClassificationLabel from './ClassificationLabel.astro';
type Work = CollectionEntry<'caseStudies'> | CollectionEntry<'projects'>;
interface Props { item: Work }
const { item } = Astro.props;
const data = item.data;
const isFlagship = data.work_kind === 'portfolio-simulation';
---
<article class:list={['card glass-surface project-card', { 'project-card--flagship': isFlagship }]} data-work-id={data.slug}>
  {isFlagship && <div class:list={['work-motif', `work-motif--${data.flagship_order}`]} aria-hidden="true"><span></span><span></span><span></span></div>}
  <p class="eyebrow"><ClassificationLabel kind={data.work_kind}/></p><h3><a href={`/work/${data.slug}/`}>{data.title}</a></h3><p class="muted">{data.summary}</p><p class="work-disclosure">{data.disclosure}</p>
  <ul class="status-labels" aria-label="Evidence and implementation status"><li class="status-label">Evidence: {data.evidence_status.replaceAll('-', ' ')}</li><li class="status-label">Implementation: {data.implementation_status.replaceAll('-', ' ')}</li></ul>
  {data.tools.length > 0 && <ul class="badges" aria-label="Tools and methods">{data.tools.map((tool) => <li class="badge">{tool}</li>)}</ul>}
  <div class="btn-row"><a class="btn" href={`/work/${data.slug}/`} aria-label={`View details: ${data.title}`}>View details</a>{data.artifact_url && <a class="text-link" href={data.artifact_url} target="_blank" rel="noopener" aria-label={`View case study PDF: ${data.title}`}>View case study PDF</a>}{data.repository_url && <a class="btn btn-ghost" href={data.repository_url} target="_blank" rel="noopener">View external repository</a>}</div>
</article>
