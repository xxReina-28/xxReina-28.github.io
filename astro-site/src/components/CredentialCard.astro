---
import type { credentials } from '../data';
interface Props { credential: (typeof credentials)[number] }
const { credential } = Astro.props;
---
<li class="credential-item glass-surface"><span class="credential-mark" aria-hidden="true">C</span><span class="credential-copy"><strong>{credential.name}</strong>{credential.issuer && <span class="muted"> — {credential.issuer}</span>}{credential.date_label && <span class="muted"> ({credential.date_label})</span>}{credential.verification_status === 'unverified' && <span class="status-label">Evidence pending</span>}{credential.evidence_url && <a href={credential.evidence_url} target="_blank" rel="noopener">View credential</a>}</span></li>
